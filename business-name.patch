From 8676db8b6221b9adf9331523edbdaae114be8931 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 04:22:02 +0000
Subject: [PATCH] Adaequare Settings: always fill Business Name

The migration set Business with set_value, so fetch_from never filled
Business Name. Fill it in the migration, in validate, and backfill
records already migrated.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016uSTwic31grtwzMMK7rPAR
---
 .../adaequare_settings/adaequare_settings.py       |  1 +
 litwatch/patches.txt                               |  1 +
 litwatch/patches/adaequare_settings_by_business.py |  6 +++++-
 .../adaequare_settings_fill_business_name.py       | 14 ++++++++++++++
 4 files changed, 21 insertions(+), 1 deletion(-)
 create mode 100644 litwatch/patches/adaequare_settings_fill_business_name.py

diff --git a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py
index c532ce1..e1e8dd0 100644
--- a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py
+++ b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py
@@ -13,6 +13,7 @@ class AdaequareSettings(Document):
 	def validate(self):
 		if self.business:
 			self.business = str(self.business).strip()
+			self.business_name = frappe.db.get_value("Business", self.business, "business_name")
 		if self.otp:
 			self.otp = str(self.otp).strip()
 			if not self.otp.isdigit():
diff --git a/litwatch/patches.txt b/litwatch/patches.txt
index e26946c..ba46d2c 100644
--- a/litwatch/patches.txt
+++ b/litwatch/patches.txt
@@ -15,3 +15,4 @@ litwatch.patches.adaequare_shared_record
 litwatch.patches.adaequare_settings_named_by_gstin
 litwatch.patches.gst_user_email_to_user_link
 litwatch.patches.adaequare_settings_by_business
+litwatch.patches.adaequare_settings_fill_business_name
diff --git a/litwatch/patches/adaequare_settings_by_business.py b/litwatch/patches/adaequare_settings_by_business.py
index f0d9cf1..e9a11e0 100644
--- a/litwatch/patches/adaequare_settings_by_business.py
+++ b/litwatch/patches/adaequare_settings_by_business.py
@@ -22,7 +22,11 @@ def execute():
 		if frappe.db.exists("Adaequare Settings", business):
 			print(f"Adaequare Settings {row.name}: Business {business} already has a record, left as is - merge by hand")
 			continue
-		frappe.db.set_value("Adaequare Settings", row.name, "business", business, update_modified=False)
+		frappe.db.set_value(
+			"Adaequare Settings", row.name,
+			{"business": business, "business_name": frappe.db.get_value("Business", business, "business_name")},
+			update_modified=False,
+		)
 		rename_doc("Adaequare Settings", row.name, business, force=True, show_alert=False)
 		print(f"Adaequare Settings {row.name} -> Business {business}")
 	frappe.db.commit()
diff --git a/litwatch/patches/adaequare_settings_fill_business_name.py b/litwatch/patches/adaequare_settings_fill_business_name.py
new file mode 100644
index 0000000..6a5f6c5
--- /dev/null
+++ b/litwatch/patches/adaequare_settings_fill_business_name.py
@@ -0,0 +1,14 @@
+import frappe
+
+
+def execute():
+	"""Fill Business Name on Adaequare Settings records that have a Business but no name yet."""
+	if not frappe.db.has_column("Adaequare Settings", "business_name"):
+		return
+	for row in frappe.get_all("Adaequare Settings", fields=["name", "business", "business_name"]):
+		if row.business and not row.business_name:
+			name = frappe.db.get_value("Business", row.business, "business_name")
+			if name:
+				frappe.db.set_value("Adaequare Settings", row.name, "business_name", name, update_modified=False)
+				print(f"Adaequare Settings {row.name}: Business Name = {name}")
+	frappe.db.commit()
