From 5b69c71fdd71f1b2b57bccf556d8c82717623a4f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 12:48:04 +0000
Subject: [PATCH] Settings: read raw single values so unsaved Check defaults
 apply

frappe.db.get_single_value returns 0 for a Check that was never saved, so
require_gstin_approval and send_account_email were read as off. Read
tabSingles directly; the defaults patch runs again with the fix. Tests set
the switches they rely on and restore the effective values.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016uSTwic31grtwzMMK7rPAR
---
 litwatch/patches.txt                              |  1 +
 litwatch/patches/onboarding_approvals_defaults.py |  4 +++-
 litwatch/settings.py                              | 11 ++++++++++-
 litwatch/tests/test_gstin_status.py               |  5 +++++
 litwatch/tests/test_onboarding_approvals.py       |  8 ++++++--
 5 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/litwatch/patches.txt b/litwatch/patches.txt
index 35a5800..0910ced 100644
--- a/litwatch/patches.txt
+++ b/litwatch/patches.txt
@@ -18,3 +18,4 @@ litwatch.patches.adaequare_settings_by_business
 litwatch.patches.adaequare_settings_fill_business_name
 litwatch.patches.gstin_ready_status
 litwatch.patches.onboarding_approvals_defaults
+litwatch.patches.onboarding_approvals_defaults #2026-10-14 read raw settings
diff --git a/litwatch/patches/onboarding_approvals_defaults.py b/litwatch/patches/onboarding_approvals_defaults.py
index 5409fc1..9e7715d 100644
--- a/litwatch/patches/onboarding_approvals_defaults.py
+++ b/litwatch/patches/onboarding_approvals_defaults.py
@@ -18,8 +18,10 @@ def execute():
 		"default_reminder_days": "7,3,1",
 		"consent_expiry_days": 30,
 	}
+	from litwatch import settings
+
 	for field, value in defaults.items():
-		if frappe.db.get_single_value("Sync Settings", field) in (None, ""):
+		if settings.raw(field) in (None, ""):  # never saved (get_single_value would say 0 for a Check)
 			frappe.db.set_single_value("Sync Settings", field, value)
 	if frappe.db.has_column("GST User", "account_email_sent_on"):
 		frappe.db.sql(
diff --git a/litwatch/settings.py b/litwatch/settings.py
index cab5301..38fbdef 100644
--- a/litwatch/settings.py
+++ b/litwatch/settings.py
@@ -16,8 +16,17 @@ DEFAULTS = {
 }
 
 
+def raw(fieldname):
+	"""The stored value, or None when it was never saved. (frappe.db.get_single_value turns a missing
+	Check into 0, which would hide the default.)"""
+	row = frappe.db.sql(
+		"SELECT value FROM `tabSingles` WHERE doctype = 'Sync Settings' AND field = %s", fieldname
+	)
+	return row[0][0] if row else None
+
+
 def get(fieldname):
-	value = frappe.db.get_single_value("Sync Settings", fieldname)
+	value = raw(fieldname)
 	return DEFAULTS.get(fieldname) if value in (None, "") else value
 
 
diff --git a/litwatch/tests/test_gstin_status.py b/litwatch/tests/test_gstin_status.py
index 809c753..21bbe3d 100644
--- a/litwatch/tests/test_gstin_status.py
+++ b/litwatch/tests/test_gstin_status.py
@@ -56,6 +56,10 @@ class TestGstinStatus(FrappeTestCase):
 		as_staff()
 		cls.mock_before = frappe.db.get_single_value("Sync Settings", "mock_portal")
 		frappe.db.set_single_value("Sync Settings", "mock_portal", 1)
+		from litwatch import settings
+
+		cls.approval_before = settings.get("require_gstin_approval")
+		frappe.db.set_single_value("Sync Settings", "require_gstin_approval", 1)  # this test checks the approval flow
 		_cleanup()
 		cls.biz = str(frappe.get_doc({"doctype": "Business", "business_name": PREFIX + " Co"}).insert(ignore_permissions=True).name)
 		if not frappe.db.exists("User", CLIENT):
@@ -71,6 +75,7 @@ class TestGstinStatus(FrappeTestCase):
 		as_staff()
 		_cleanup()
 		frappe.db.set_single_value("Sync Settings", "mock_portal", cls.mock_before or 0)
+		frappe.db.set_single_value("Sync Settings", "require_gstin_approval", cls.approval_before or 0)
 		frappe.db.commit()
 		super().tearDownClass()
 
diff --git a/litwatch/tests/test_onboarding_approvals.py b/litwatch/tests/test_onboarding_approvals.py
index 47986be..bee50a2 100644
--- a/litwatch/tests/test_onboarding_approvals.py
+++ b/litwatch/tests/test_onboarding_approvals.py
@@ -76,8 +76,12 @@ class TestOnboardingApprovals(FrappeTestCase):
 	def setUpClass(cls):
 		super().setUpClass()
 		as_staff()
-		cls.before = {f: frappe.db.get_single_value("Sync Settings", f) for f in SETTINGS}
+		from litwatch import settings
+
+		cls.before = {f: settings.get(f) for f in SETTINGS}  # effective values, defaults included
 		frappe.db.set_single_value("Sync Settings", "mock_portal", 1)
+		frappe.db.set_single_value("Sync Settings", "require_gstin_approval", 1)
+		frappe.db.set_single_value("Sync Settings", "send_account_email", 1)
 		_cleanup()
 		if not frappe.db.exists("User", CLIENT):
 			frappe.get_doc({"doctype": "User", "email": CLIENT, "first_name": "Approvals Client",
@@ -90,7 +94,7 @@ class TestOnboardingApprovals(FrappeTestCase):
 		as_staff()
 		_cleanup()
 		for f, v in cls.before.items():
-			frappe.db.set_single_value("Sync Settings", f, v)
+			frappe.db.set_single_value("Sync Settings", f, v or 0)
 		frappe.db.commit()
 		super().tearDownClass()
 
