@@ -184,10 +192,47 @@
 						frappe.msgprint({
 							title: __("OTP verified"),
 							indicator: "green",
-							message: __("{0} is connected. Consent valid until {1}. The OTP is saved in this record.", [
-								gstin,
-								res.validUntil || "-",
