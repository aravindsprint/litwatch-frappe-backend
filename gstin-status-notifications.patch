+					args: { gstin: frm.doc.name, reason: values.reason },
+					freeze: true,
+					callback: () => {
+						frm.reload_doc();
+						frappe.show_alert({ message: __("{0} rejected", [frm.doc.name]), indicator: "orange" });
+					},
+				}),
+			__("Reject GSTIN connection"),
+			__("Reject")
+		);
+	}
+})();
