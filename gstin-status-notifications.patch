+	});
+
+	function approve(frm) {
+		frappe.confirm(__("Approve the GST portal connection of {0}?", [frm.doc.name]), () =>
+			frappe.call({
+				method: "litwatch.api.gstin.approve_gstin_connection",
+				args: { gstin: frm.doc.name },
+				freeze: true,
+				callback: (r) => {
+					frm.reload_doc();
+					frappe.show_alert({
