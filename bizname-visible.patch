From 9d9a92ada0073c7ad0e0b72f2655382e3f6304eb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 04:26:55 +0000
Subject: [PATCH] Adaequare Settings: Business Name always visible

Frappe hides empty read-only fields; make it a normal field (still filled
from the Business and reset on save).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016uSTwic31grtwzMMK7rPAR
---
 .../doctype/adaequare_settings/adaequare_settings.json     | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.json b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.json
index 133dfca..518546b 100644
--- a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.json
+++ b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.json
@@ -35,9 +35,10 @@
    "fieldname": "business_name",
    "fieldtype": "Data",
    "label": "Business Name",
-   "read_only": 1,
    "fetch_from": "business.business_name",
-   "in_list_view": 1
+   "in_list_view": 1,
+   "in_standard_filter": 1,
+   "description": "Filled from the selected Business (always reset to the Business's name on save)"
   },
   {
    "fieldname": "client_id",
@@ -99,7 +100,7 @@
  "grid_page_length": 50,
  "index_web_pages_for_search": 1,
  "links": [],
- "modified": "2026-10-14 10:00:00.000000",
+ "modified": "2026-10-14 10:30:00.000000",
  "modified_by": "Administrator",
  "module": "Litwatch",
  "name": "Adaequare Settings",
