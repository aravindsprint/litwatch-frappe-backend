From 54401764fec829e91822c875848b4b8dc326d770 Mon Sep 17 00:00:00 2001
From: Aravind <aravindsprint@gmail.com>
Date: Tue, 13 Oct 2026 02:24:18 +0000
Subject: [PATCH] scope: per-request cache via getattr/setattr (frappe.local is
 a werkzeug Local, no __dict__)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016uSTwic31grtwzMMK7rPAR
---
 litwatch/scope.py                   | 17 +++++++++++++++--
 litwatch/tests/test_user_scoping.py |  2 +-
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/litwatch/scope.py b/litwatch/scope.py
index 81cd914..506f244 100644
--- a/litwatch/scope.py
+++ b/litwatch/scope.py
@@ -35,6 +35,19 @@ STAFF_ROLE = "System Manager"
 _CACHE = "litwatch_scope_cache"
 
 
+def _cache():
+	"""Per-request cache. frappe.local is a werkzeug Local, so only get/setattr work on it."""
+	cache = getattr(frappe.local, _CACHE, None)
+	if cache is None:
+		cache = {}
+		setattr(frappe.local, _CACHE, cache)
+	return cache
+
+
+def reset_cache():
+	setattr(frappe.local, _CACHE, {})
+
+
 # ---------------------------------------------------------------------------
 # Who / what
 # ---------------------------------------------------------------------------
@@ -85,7 +98,7 @@ def _businesses_of(gst_user):
 
 def get_scope():
 	"""None = everything; otherwise the list of Business IDs the request may see."""
-	cache = frappe.local.__dict__.setdefault(_CACHE, {})
+	cache = _cache()
 	user = frappe.session.user if getattr(frappe.local, "session", None) else "Guest"
 	key = (user, requested_gst_user())
 	if key in cache:
@@ -109,7 +122,7 @@ def get_scope():
 
 def add_to_scope(business_id):
 	"""Make a just-created Business visible for the rest of this request."""
-	cache = frappe.local.__dict__.get(_CACHE) or {}
+	cache = getattr(frappe.local, _CACHE, None) or {}
 	for scope in cache.values():
 		if scope is not None and str(business_id) not in scope:
 			scope.append(str(business_id))
diff --git a/litwatch/tests/test_user_scoping.py b/litwatch/tests/test_user_scoping.py
index 22533be..60fd1be 100644
--- a/litwatch/tests/test_user_scoping.py
+++ b/litwatch/tests/test_user_scoping.py
@@ -16,7 +16,7 @@ def as_gst_user(email=None):
 	"""Act like the frontend: shared key (Administrator) + gstUser."""
 	frappe.set_user("Administrator")
 	frappe.local.form_dict = frappe._dict({"gstUser": email} if email else {})
-	frappe.local.__dict__.pop(scope._CACHE, None)
+	scope.reset_cache()
 
 
 class TestUserScoping(FrappeTestCase):
-- 
