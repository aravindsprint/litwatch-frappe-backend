 1 file changed, 65 insertions(+), 3 deletions(-)

diff --git a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.js b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.js
index f1f03b6..ae13a5d 100644
--- a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.js
+++ b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.js
@@ -154,27 +154,57 @@
