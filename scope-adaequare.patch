From a32a60bd947d20d85ac5f7fedc96f95388f8e306 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 04:48:18 +0000
Subject: [PATCH] Scope Adaequare Settings to the GST User's businesses

With a gstUser, the Resource API listed every business's record (Client ID
and OTP). Add the permission query condition, has_permission hook and
controller check like the other scoped doctypes; tests cover list and
single-record access.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016uSTwic31grtwzMMK7rPAR
---
 litwatch/hooks.py                                      |  2 ++
 .../doctype/adaequare_settings/adaequare_settings.py   |  9 +++++++++
 litwatch/scope.py                                      | 10 +++++++++-
 litwatch/tests/test_user_scoping.py                    | 10 ++++++++++
 4 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/litwatch/hooks.py b/litwatch/hooks.py
index 28fa80d..910a144 100644
--- a/litwatch/hooks.py
+++ b/litwatch/hooks.py
@@ -270,6 +270,7 @@ permission_query_conditions = {
 	"GST User": "litwatch.scope.gst_user_query",
 	"GST Sync Log": "litwatch.scope.gst_sync_log_query",
 	"GST OTP Request": "litwatch.scope.gst_otp_request_query",
+	"Adaequare Settings": "litwatch.scope.adaequare_settings_query",
 }
 
 has_permission = {
@@ -281,4 +282,5 @@ has_permission = {
 	"Client Document": "litwatch.scope.has_permission",
 	"Audit Log": "litwatch.scope.has_permission",
 	"GST User": "litwatch.scope.has_permission",
+	"Adaequare Settings": "litwatch.scope.has_permission",
 }
diff --git a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py
index e1e8dd0..5b1cc90 100644
--- a/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py
+++ b/litwatch/litwatch/doctype/adaequare_settings/adaequare_settings.py
@@ -10,6 +10,15 @@ class AdaequareSettings(Document):
 	# One record per Business (autoname "field:business"): the business's GSP app
 	# (Client ID, Secret, cached Access Token) and its latest portal OTP.
 
+	def has_permission(self, permtype="read", *, debug=False, user=None):
+		# Per-user scoping: a GST User sees only their own Businesses' records
+		# (hooks are skipped for Administrator, the frontend's shared key).
+		from litwatch.scope import doc_in_scope
+
+		if not doc_in_scope(self):
+			return False
+		return super().has_permission(permtype, debug=debug, user=user)
+
 	def validate(self):
 		if self.business:
 			self.business = str(self.business).strip()
diff --git a/litwatch/scope.py b/litwatch/scope.py
index 506f244..e787778 100644
--- a/litwatch/scope.py
+++ b/litwatch/scope.py
@@ -15,7 +15,8 @@ What they see
 -------------
 - GST User found: only the Businesses in its ``businesses`` table, and the
   GSTINs, Notices, Payments, Review Queue Items, Client Documents, Audit Log
-  entries, sync logs and OTP requests that belong to those Businesses.
+  entries, sync logs, OTP requests and Adaequare Settings that belong to those
+  Businesses.
 - No GST User record, but the user is System Manager (firm staff): everything.
 - Anyone else without a GST User record: "GST User ... not found" (HTTP 404),
   the same answer get_clients has always given, so the frontend's existing
@@ -206,6 +207,8 @@ def doc_in_scope(doc):
 		return str(doc.get("client") or "") in scope
 	if dt == "GST User":
 		return (doc.name or "").lower() == (scope_user() or "").lower()
+	if dt == "Adaequare Settings":
+		return str(doc.get("business") or doc.name or "") in scope
 	return True
 
 
@@ -273,3 +276,8 @@ def gst_sync_log_query(user=None, doctype=None):
 
 def gst_otp_request_query(user=None, doctype=None):
 	return _cond(lambda s: _in("`tabGST OTP Request`.`gstin`", scope_gstins(s)))
+
+
+def adaequare_settings_query(user=None, doctype=None):
+	# one record per Business, named by the Business ID
+	return _cond(lambda s: _in("`tabAdaequare Settings`.`name`", s))
diff --git a/litwatch/tests/test_user_scoping.py b/litwatch/tests/test_user_scoping.py
index c64848a..4d17830 100644
--- a/litwatch/tests/test_user_scoping.py
+++ b/litwatch/tests/test_user_scoping.py
@@ -19,6 +19,7 @@ def _cleanup():
 	businesses = frappe.get_all("Business", filters={"business_name": ["like", "Scope Test%"]}, pluck="name")
 	businesses = [str(b) for b in businesses]
 	if businesses:
+		frappe.db.delete("Adaequare Settings", {"name": ["in", businesses]})
 		frappe.db.delete("Notice", {"business_id": ["in", businesses]})
 		frappe.db.delete("GST User Business", {"business": ["in", businesses]})
 		frappe.db.delete("Business GSTIN", {"parent": ["in", businesses]})
@@ -54,6 +55,9 @@ class TestUserScoping(FrappeTestCase):
 		cls.notice_a = frappe.get_doc({"doctype": "Notice", "client_id": "Administrator", "business_id": str(cls.biz_a)}).insert(ignore_permissions=True).name
 		cls.notice_b = frappe.get_doc({"doctype": "Notice", "client_id": "Administrator", "business_id": str(cls.biz_b)}).insert(ignore_permissions=True).name
 		cls.notice_gstin_a = frappe.get_doc({"doctype": "Notice", "client_id": "Administrator", "gstin": GSTIN_A}).insert(ignore_permissions=True).name
+		for biz in (cls.biz_a, cls.biz_b):
+			frappe.get_doc({"doctype": "Adaequare Settings", "business": str(biz), "client_id": f"scope-{biz}",
+			                "client_secret": "x", "is_active": 1}).insert(ignore_permissions=True)
 		if not frappe.db.exists("User", CLIENT_EMAIL):
 			frappe.get_doc({"doctype": "User", "email": CLIENT_EMAIL, "first_name": "Scope Client",
 			                "user_type": "Website User", "send_welcome_email": 0}).insert(ignore_permissions=True)
@@ -77,6 +81,7 @@ class TestUserScoping(FrappeTestCase):
 		as_gst_user(None)
 		self.assertIsNone(scope.get_scope())
 		self.assertTrue({str(self.biz_a), str(self.biz_b)} <= self.names("Business"))
+		self.assertTrue({str(self.biz_a), str(self.biz_b)} <= self.names("Adaequare Settings"))
 
 	# --- lists (Resource API uses get_list) ------------------------------
 	def test_lists_are_filtered(self):
@@ -88,6 +93,7 @@ class TestUserScoping(FrappeTestCase):
 		notices = self.names("Notice", filters={"name": ["in", [self.notice_a, self.notice_b, self.notice_gstin_a]]})
 		self.assertEqual({self.notice_a, self.notice_gstin_a}, notices)
 		self.assertEqual({CLIENT_EMAIL}, self.names("GST User"))
+		self.assertEqual({str(self.biz_a)}, self.names("Adaequare Settings"))
 
 	# --- single records (Resource API read/update/delete) ----------------
 	def test_single_records_are_checked(self):
@@ -96,6 +102,10 @@ class TestUserScoping(FrappeTestCase):
 		self.assertFalse(frappe.get_doc("Notice", self.notice_b).has_permission("read"))
 		self.assertFalse(frappe.get_doc("Business", self.biz_b).has_permission("write"))
 		self.assertFalse(frappe.get_doc("GSTIN", GSTIN_B).has_permission("read"))
+		self.assertTrue(frappe.get_doc("Adaequare Settings", str(self.biz_a)).has_permission("read"))
+		self.assertFalse(frappe.get_doc("Adaequare Settings", str(self.biz_b)).has_permission("read"))
+		with self.assertRaises(frappe.PermissionError):
+			frappe.get_doc("Adaequare Settings", str(self.biz_b)).check_permission("write")
 		with self.assertRaises(frappe.PermissionError):
 			frappe.get_doc("Notice", self.notice_b).check_permission("read")
 		with self.assertRaises(frappe.PermissionError):
